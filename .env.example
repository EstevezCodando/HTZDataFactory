# HTZDataFactory — configuração local
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUÇÕES
#   1. Copie este arquivo para .env  (nunca commite o .env)
#        Windows:  copy .env.example .env
#        Linux:    cp .env.example .env
#   2. Preencha os caminhos das seções abaixo
#   3. docker compose up --build -d
# ─────────────────────────────────────────────────────────────────────────────


# ── CAMINHOS DOS DADOS EXTERNOS ───────────────────────────────────────────────
# Pasta que contém o arquivo fabdem_v1_2_brasil_celulas_1x1.geojson
# e os tiles *.tif já baixados (ou que serão baixados por demanda).
# Pode ser qualquer caminho absoluto na sua máquina.
#
# Exemplos:
#   Windows:  FABDEM_DIR=C:/Dados/FABDEM
#   Linux:    FABDEM_DIR=/mnt/dados/fabdem
FABDEM_DIR=C:/Dados/FABDEM

# Pasta que contém o arquivo TIF do MapBiomas (~5.5 GB).
# O arquivo pode ter qualquer nome — defina o nome exato em MAPBIOMAS_FILENAME.
#
# Exemplos:
#   Windows:  MAPBIOMAS_DIR=C:/Dados/MapBiomas
#   Linux:    MAPBIOMAS_DIR=/mnt/dados/mapbiomas
MAPBIOMAS_DIR=C:/Dados/MapBiomas

# Nome exato do arquivo TIF dentro de MAPBIOMAS_DIR
# (padrão da Collection 10 — ajuste se usar outra coleção)
MAPBIOMAS_FILENAME=mapbiomas_10m_collection2_integration_v1-classification_2023.tif


# ── SEGURANÇA ─────────────────────────────────────────────────────────────────
# Chave para endpoint DELETE /cache (opcional — deixe em branco para sem proteção)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
HTZ_API_KEY=

# Credenciais do Flower (dashboard de workers)
FLOWER_USER=admin
FLOWER_PASSWORD=troque_aqui

# Origens permitidas no CORS (separadas por vírgula)
# Padrão localhost — ajuste se acessar de outra máquina na rede
CORS_ORIGINS=http://localhost:8080


# ── PORTAS ────────────────────────────────────────────────────────────────────
# Porta principal (frontend + API via nginx)
HTTP_PORT=8080

# Porta do Flower (monitoramento de workers)
FLOWER_PORT=5555


# ── PERFORMANCE ───────────────────────────────────────────────────────────────
# Cache GDAL em MB — use ~25% da RAM disponível
#   16 GB RAM → 4096
#   32 GB RAM → 8192
#   64 GB RAM → 16384
GDAL_CACHEMAX=4096

# Jobs simultâneos (recomendado: metade dos cores físicos)
MAX_CONCURRENT_JOBS=4

# Processos paralelos no worker Celery
WORKER_CONCURRENCY=4

# Memória máxima por container worker
WORKER_MEMORY_LIMIT=8G

# Tamanho máximo de upload via /convert (bytes) — padrão 500 MB
MAX_UPLOAD_BYTES=524288000
